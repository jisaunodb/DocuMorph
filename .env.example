# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MongoDB Connection String (Atlas or local)
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/documorph?retryWrites=true&w=majority"

# JWT Secret for authentication signing
JWT_SECRET="documorph_production_jwt_secret_key_change_in_production"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Client and Server URLs for CORS and Canonical Links
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# Application Settings
MAX_FILE_SIZE_MB=50
NODE_ENV="development"

# SSLCommerz Payment Gateway (https://sslcommerz.com)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX=true

